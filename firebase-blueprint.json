{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "photoURL": { "type": "string" },
        "mobile": { "type": "string" },
        "dob": { "type": "string", "format": "date" },
        "bio": { "type": "string" },
        "address": { "type": "string" },
        "referralCode": { "type": "string" },
        "referredBy": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "email"]
    },
    "Listing": {
      "title": "Listing",
      "description": "An item listed for sale",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "location": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "sellerId": { "type": "string" },
        "sellerName": { "type": "string" },
        "sellerPhoto": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "sold"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "price", "sellerId", "status"]
    },
    "Chat": {
      "title": "Chat",
      "description": "A conversation between a buyer and a seller",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "listingId": { "type": "string" },
        "listingTitle": { "type": "string" },
        "sellerId": { "type": "string" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "lastMessage": { "type": "string" },
        "lastMessageAt": { "type": "string", "format": "date-time" }
      },
      "required": ["listingId", "participants"]
    },
    "Message": {
      "title": "Message",
      "description": "A single message in a chat",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "chatId": { "type": "string" },
        "senderId": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "call", "image", "video", "location"] },
        "text": { "type": "string" },
        "fileUrl": { "type": "string" },
        "location": { 
          "type": "object",
          "properties": {
            "latitude": { "type": "number" },
            "longitude": { "type": "number" },
            "isLive": { "type": "boolean" },
            "expiresAt": { "type": "string", "format": "date-time" }
          }
        },
        "offerDetails": {
          "type": "object",
          "properties": {
            "price": { "type": "number" },
            "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] }
          }
        },
        "callStatus": { "type": "string", "enum": ["ended", "missed", "rejected"] },
        "duration": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["chatId", "senderId"]
    },
    "Favorite": {
      "title": "Favorite",
      "description": "A listing favorited by a user",
      "type": "object",
      "properties": {
        "listingId": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["listingId", "userId"]
    },
    "Category": {
      "title": "Category",
      "description": "A listing category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "image": { "type": "string" }
      },
      "required": ["name"]
    },
    "Report": {
      "title": "Report",
      "description": "A user report on a listing",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "listingId": { "type": "string" },
        "listingTitle": { "type": "string" },
        "reporterId": { "type": "string" },
        "reporterEmail": { "type": "string" },
        "reason": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "resolved"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["listingId", "reporterId", "reason", "status"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "A support request from a user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "closed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "message", "status"]
    },
    "Rule": {
      "title": "Rule",
      "description": "App safety rule or guidelines",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["title", "description"]
    },
    "Call": {
      "title": "Call",
      "description": "An audio call between users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "chatId": { "type": "string" },
        "callerId": { "type": "string" },
        "callerName": { "type": "string" },
        "receiverId": { "type": "string" },
        "receiverName": { "type": "string" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["ringing", "connected", "ended", "rejected"] },
        "offer": { "type": "object" },
        "answer": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["callerId", "receiverId", "status", "participants"]
    },
    "IceCandidate": {
      "title": "IceCandidate",
      "description": "WebRTC ICE candidate for signaling",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "candidate": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["candidate"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/users/{uid}/favorites/{listingId}": {
      "schema": "Favorite",
      "description": "User's favorite listings"
    },
    "/listings/{listingId}": {
      "schema": "Listing",
      "description": "Item listings"
    },
    "/chats/{chatId}": {
      "schema": "Chat",
      "description": "Chat sessions"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages within a chat"
    },
    "/calls/{callId}": {
      "schema": "Call",
      "description": "Voice call signaling"
    },
    "/calls/{callId}/callerCandidates/{candidateId}": {
      "schema": "IceCandidate",
      "description": "ICE candidates from the caller"
    },
    "/calls/{callId}/receiverCandidates/{candidateId}": {
      "schema": "IceCandidate",
      "description": "ICE candidates from the receiver"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Listing categories"
    },
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "User reports"
    },
    "/support/{ticketId}": {
      "schema": "SupportTicket",
      "description": "Support tickets"
    },
    "/rules/{ruleId}": {
      "schema": "Rule",
      "description": "Safety rules and guidelines"
    }
  }
}
